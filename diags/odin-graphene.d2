# odin-graphene: its place in the binding graph
# Render:  d2 diags/odin-graphene.d2 diags/odin-graphene.svg

direction: down

title: "odin-graphene" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}

this: "odin-graphene\nGraphene 1.10.8" {
  style.fill: "#eef6ff"
}
lib: "graphene-1.0 (shared library)" {
  style.fill: "#fff6e6"
}
consumers: "every other binding and every app\nimport \"graphene:<pkg>\"" {
  style.fill: "#f2f2f2"
}

consumers -> this: collection graphene
this -> lib: foreign import
